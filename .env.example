# Copy to .env. start.bat, start.ps1, and start.sh do that when .env is missing.
# npm run dev also reads .env.local when that file exists; it overrides .env.
# Do not commit either file. Nothing below is a real secret.
#
# Recommended default: your own OpenAI-compatible Chat Completions API.
# Leave the URL and key empty and WeiDu still opens. The page asks you to
# configure an API. Generation stays on editable placeholder text. It does not crash.

# Login for the local account `local`.
# The value below is a local placeholder, not a secret you must keep.
# If both passwords are unset, development falls back to changeme.
# The Docker image sets NODE_ENV=production and then requires one of these.
APP_PASSWORD=replace-with-a-password
# AUTH_PASSWORD=

# Signs the session cookie. Replace this before anyone else can reach the app.
# If empty, the app derives a secret from the password, and changing the password logs you out.
APP_SESSION_SECRET=replace-with-a-long-random-string

# Recommended route. Shape only, not a default host: https://api.example.com/v1
# Used by the ".env OpenAI-compatible API" choice in Settings.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Used when the URL and key are both set. Empty means gpt-4o-mini.
OPENAI_MODEL=

# Listen address for npm run dev, npm run start, and the one-click scripts.
# Default is 127.0.0.1 (this machine only). Set WEIDU_HOST=0.0.0.0 only when
# you mean to accept connections from other machines.
# Docker does not use WEIDU_HOST. The image binds 0.0.0.0 so the published port works.
# WEIDU_HOST=127.0.0.1
# PORT=4721

# Optional self-hosted DSH. Leave all three empty unless you run your own.
# Not the default. Plugins on that DSH are your business. WeiDu does not require a purge plugin.
DSH_BASE_URL=
DSH_TOKEN=
DSH_SESSION_ID=
# Optional wait for one DSH turn, in milliseconds. Empty uses 1200000 (20 minutes), max 1800000.
# DSH_TIMEOUT_MS=
