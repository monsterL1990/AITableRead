# Copy to .env. start.bat, start.ps1, and start.sh do that when .env is missing.
# npm run dev also reads .env.local when that file exists; it overrides .env.
# Do not commit either file. Nothing below is a real secret.
#
# Recommended default: your own OpenAI-compatible Chat Completions API.
# Leave the URL and key empty and WeiDu still opens. The page asks you to
# configure an API. Generation stays on editable placeholder text. It does not crash.

# Login is off for a local desk (`npm run dev` and the one-click scripts).
# Set WEIDU_AUTH=on to require the password below and the session cookie.
# `npm run start` and the Docker image use NODE_ENV=production, so login stays
# on until you set WEIDU_AUTH=off. Do not turn it off if other machines can
# reach this process (WEIDU_HOST=0.0.0.0, or Docker's published port).
# WEIDU_AUTH=
# APP_PASSWORD is used only when login is on. The value below is a placeholder.
# If both passwords are unset, development falls back to changeme.
# Production refuses to boot the login without one of these.
APP_PASSWORD=replace-with-a-password
# AUTH_PASSWORD=

# Signs the session cookie. Replace this before anyone else can reach the app.
# If empty, the app derives a secret from the password, and changing the password logs you out.
APP_SESSION_SECRET=replace-with-a-long-random-string

# Recommended route. Shape only, not a default host: https://api.example.com/v1
# Used by the ".env OpenAI-compatible API" choice in Settings.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Used when the URL and key are both set. Empty means gpt-4o-mini.
OPENAI_MODEL=

# Interface language when nobody has used the 中文 / English switch yet.
# zh or en. A saved choice in data/store.json wins over this. If unset, the
# browser's Accept-Language is used: English preference → English, otherwise Chinese.
# WEIDU_LOCALE=

# Listen address for npm run dev, npm run start, and the one-click scripts.
# Default is 127.0.0.1 (this machine only). Set WEIDU_HOST=0.0.0.0 only when
# you mean to accept connections from other machines.
# Docker does not use WEIDU_HOST. The image binds 0.0.0.0 so the published port works.
# WEIDU_HOST=127.0.0.1
# PORT=4721

# Optional self-hosted DSH. Leave these empty unless you run your own.
# Settings can save the same connection with the DSH wizard. A saved connection wins.
# Not the default. Plugins on that DSH are yours to install. WeiDu does not require purge.
DSH_BASE_URL=
DSH_TOKEN=
DSH_SESSION_ID=
# Optional HTTP Basic Auth in front of DSH. Leave empty when it does not ask.
# DSH_BASIC_USER=
# DSH_BASIC_PASSWORD=
# Loopback ports the settings wizard probes. Empty means 3080,3081,3099.
# 3080 is the port printed by `npx @deepseek-ai/dsh web`.
# DSH_PROBE_PORTS=3080,3081,3099
# Optional wait for one DSH turn, in milliseconds. Empty uses 1200000 (20 minutes), max 1800000.
# DSH_TIMEOUT_MS=
